      "seed": 230289545,
      "version": 249,
      "versionNonce": 917000071,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782197687379,
      "link": null,
      "locked": false,
      "text": "Special Note:\n============\n\nTheir is a class called Array in java which allows us to perform above operation on Array \nbut even this class is part of Collection framework.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Special Note:\n============\n\nTheir is a class called Array in java which allows us to perform above operation on Array \nbut even this class is part of Collection framework.",
      "autoResize": true,
      "lineHeight": 1.25
    },
