      "boundElements": null,
      "updated": 1782290122764,
      "link": null,
      "locked": false,
      "text": "List is a child interface of Collection Interface.\n\nIt represents ordered collection of elements.\n\nIt store elements in insetion order.\n\nThats why it is commonlly known as List is an insertion oreder preserved.\n\nWe can access elements using indexes.\n\nIt allow duplicates elements.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "List is a child interface of Collection Interface.\n\nIt represents ordered collection of elements.\n\nIt store elements in insetion order.\n\nThats why it is commonlly known as List is an insertion oreder preserved.\n\nWe can access elements using indexes.\n\nIt allow duplicates elements.",
      "autoResize": true,
      "lineHeight": 1.25
    },
