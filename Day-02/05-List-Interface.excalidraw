      "isDeleted": false,
      "boundElements": null,
      "updated": 1782290967794,
      "link": null,
      "locked": false,
      "text": "ArrayList can be created in 2 ways\n================================\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ArrayList can be created in 2 ways\n================================\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aA9LzI8r3Xwt4GJrgdBAy",
      "type": "text",
      "x": 254,
      "y": 1455,
      "width": 496,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 199593299,
      "version": 189,
      "versionNonce": 1465257053,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782292024635,
      "link": null,
      "locked": false,
      "text": "Their are two ways to create to ArrayList object.\n\n1. UnTypeSafe \n\nand \n\n2. TypeSafe\n\n1.TypeUnSafe\n=============\n\nArrayList ob=new ArrayList();",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Their are two ways to create to ArrayList object.\n\n1. UnTypeSafe \n\nand \n\n2. TypeSafe\n\n1.TypeUnSafe\n=============\n\nArrayList ob=new ArrayList();",
      "autoResize": true,
      "lineHeight": 1.25
    },
