      "seed": 2110901380,
      "version": 9,
      "versionNonce": 1814000316,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792159957706,
      "link": null,
      "locked": false,
      "text": "Operator Precedence (Highest to Lowest):\n1. () — Parentheses\n2. ^ — Exponent\n3. *, /, % — Multiplication, Division, Modulus\n4. +, - — Addition, Subtraction",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Operator Precedence (Highest to Lowest):\n1. () — Parentheses\n2. ^ — Exponent\n3. *, /, % — Multiplication, Division, Modulus\n4. +, - — Addition, Subtraction",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MAjtNE3RijtXgAVE9fIO9",
      "type": "text",
      "x": 485.258822,
      "y": -1.0024952126781272,
      "width": 485,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 1240743228,
      "version": 124,
      "versionNonce": 845913476,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792160225635,
      "link": null,
      "locked": false,
      "text": "Infix: ( A + B * C )\n\n-> A +  B * C      first solve highest precedence .\n\n-> A + BC*\n\n-> BC*A+\n\nPostfix:  BC*A+ ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Infix: ( A + B * C )\n\n-> A +  B * C      first solve highest precedence .\n\n-> A + BC*\n\n-> BC*A+\n\nPostfix:  BC*A+ ",
      "autoResize": true,
      "lineHeight": 1.25
    },
