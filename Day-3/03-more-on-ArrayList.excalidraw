      "link": null,
      "locked": false,
      "text": "What Happens when ArrayList becomes full ?\n========================================\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What Happens when ArrayList becomes full ?\n========================================\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Kmz7kurYP6klDSgQvfd1B",
      "type": "text",
      "x": 283,
      "y": 190,
      "width": 852,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1564004482,
      "version": 365,
      "versionNonce": 639436894,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782358078458,
      "link": null,
      "locked": false,
      "text": "When ArrayList becomes full java performs 3 actions :\n\n1. Java create a new Array of greater size than previous Array inside ArrayList object.\n\n2. Java shift all elements from old Array to new Array, and also add new element.\n\n3. old Array gets available for GC.\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When ArrayList becomes full java performs 3 actions :\n\n1. Java create a new Array of greater size than previous Array inside ArrayList object.\n\n2. Java shift all elements from old Array to new Array, and also add new element.\n\n3. old Array gets available for GC.\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
