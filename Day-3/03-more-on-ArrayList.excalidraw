      "isDeleted": false,
      "boundElements": null,
      "updated": 1782359340700,
      "link": null,
      "locked": false,
      "text": "new capacity\n\n= ( cc * 3 ) / 2 + 1\n\n( 10 * 3)  / 2 + 1 = 16\n\n( 16 * 3 ) / 2 + 1 = 25",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "new capacity\n\n= ( cc * 3 ) / 2 + 1\n\n( 10 * 3)  / 2 + 1 = 16\n\n( 16 * 3 ) / 2 + 1 = 25",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "z7dQZkidxc5TqZwo-dYJp",
      "type": "text",
      "x": 832.5420702091149,
      "y": 697.9381962016113,
      "width": 257,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 2073331422,
      "version": 132,
      "versionNonce": 1748077314,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782359522079,
      "link": null,
      "locked": false,
      "text": "new capacity\n\n= cc + cc >> 1\n\n10 + 10 >> 1 = 10 + 5 = 15\n\n15 + 15 >> 1 = 15 + 7 = 22\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "new capacity\n\n= cc + cc >> 1\n\n10 + 10 >> 1 = 10 + 5 = 15\n\n15 + 15 >> 1 = 15 + 7 = 22\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
