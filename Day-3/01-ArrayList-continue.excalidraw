    },
    {
      "id": "59oS0M9i-UfjYK5YaGZ3W",
      "type": "text",
      "x": 281,
      "y": 176,
      "width": 840,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 794754161,
      "version": 987,
      "versionNonce": 53376927,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782356140344,
      "link": null,
      "locked": false,
      "text": "In java there are two methods to add elements in ArrayList.\n\n1. public boolean add(Object obj) : This method comes from Collection interface.\nIt appends(add at last) the element in ArrayList.\nIf the element is added in ArrayList it returns true otherwise false.\n\n2. public void add(int i, Object obj) : This method comes from List interface .\nIt takes two arguements first is index number and second is object to be added.\nIf an element is already present at that index then element is shifted towards right.\nThe index given should be between 0 to length . If wrong index is given then java \nwill throw Exception called IndexOutOfBoundsException.\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In java there are two methods to add elements in ArrayList.\n\n1. public boolean add(Object obj) : This method comes from Collection interface.\nIt appends(add at last) the element in ArrayList.\nIf the element is added in ArrayList it returns true otherwise false.\n\n2. public void add(int i, Object obj) : This method comes from List interface .\nIt takes two arguements first is index number and second is object to be added.\nIf an element is already present at that index then element is shifted towards right.\nThe index given should be between 0 to length . If wrong index is given then java \nwill throw Exception called IndexOutOfBoundsException.\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
