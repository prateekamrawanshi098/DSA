      "boundElements": null,
      "updated": 1793806531013,
      "link": null,
      "locked": false,
      "text": "public class Example4 {\n    public static void greetings(int n){\n        if (n<=0){\n            return;\n        }\n        System.out.println(\"Good Evening\");\n        greetings(n-1);\n        System.out.println(\"Bye\");\n    }\n\n    public static void main(String[] args) {\n        greetings(3);\n        System.out.println(\"Good Night\");\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class Example4 {\n    public static void greetings(int n){\n        if (n<=0){\n            return;\n        }\n        System.out.println(\"Good Evening\");\n        greetings(n-1);\n        System.out.println(\"Bye\");\n    }\n\n    public static void main(String[] args) {\n        greetings(3);\n        System.out.println(\"Good Night\");\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
