      "index": "b14",
      "roundness": null,
      "seed": 1398032712,
      "version": 102,
      "versionNonce": 1258335288,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783746037761,
      "link": null,
      "locked": false,
      "text": "while LinkedList just need to break two links and connect 4 links.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "while LinkedList just need to break two links and connect 4 links.",
