      "seed": 1745445944,
      "version": 163,
      "versionNonce": 1899609400,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783745999881,
      "link": null,
      "locked": false,
      "text": "As we know that addition in ArrayList may require shifting ,copying, creating\nnew Array",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As we know that addition in ArrayList may require shifting ,copying, creating new Array",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gu3T1c-V4e1q6U_ZDZ-19",
