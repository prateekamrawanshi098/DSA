    {
      "id": "X5d3c-WYDiew0e7tmiNjZ",
      "type": "text",
      "x": 245,
      "y": 608,
      "width": 1260,
      "height": 1225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
