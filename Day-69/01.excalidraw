      "link": null,
      "locked": false,
      "text": "public class Example2 {\n\n    public static void fun(int n) {\n        if (n <= 0) {\n            return ;\n        }\n        System.out.print(n+\" , \");\n        fun(n-1);\n        fun(n-1);\n    }\n\n    public static void main(String[] args) {\n    fun(3);\n    }\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class Example2 {\n\n    public static void fun(int n) {\n        if (n <= 0) {\n            return ;\n        }\n        System.out.print(n+\" , \");\n        fun(n-1);\n        fun(n-1);\n    }\n\n    public static void main(String[] args) {\n    fun(3);\n    }\n}\n",
