    {
      "id": "NP4HIAKnUzr48e5NKWhBi",
      "type": "text",
      "x": 101.72778030479697,
      "y": 1279.99826701225,
      "width": 405.8982163900433,
      "height": 436.2097729697854,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
