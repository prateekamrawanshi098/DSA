    {
      "id": "NUp1bVuI7HdvHnhfSw2SF",
      "type": "text",
      "x": 252,
      "y": 183,
      "width": 637,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1118823307,
      "version": 686,
      "versionNonce": 1369932850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791866837760,
      "link": null,
      "locked": false,
      "text": "complexity is a way of measuring how efficient a solution is in\nterms of resources for a given solution .\n\nresourses:\n\n1. space -> Number of bytes consumed by algorithm in main\nmemory while running .\n\n2. time -> it is not the physical time .\n\nRather it is the time taken by an algorithm in terms of\ninstruction processed with respect to the number of data item .\n\nNotation of time complexity\n=========================\n\n1. Omega ( Ω )\n\n2. Theata ( θ )\n\n3. Big O ( O )",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "complexity is a way of measuring how efficient a solution is in terms of resources for a given solution .\n\nresourses:\n\n1. space -> Number of bytes consumed by algorithm in main memory while running .\n\n2. time -> it is not the physical time .\n\nRather it is the time taken by an algorithm in terms of instruction processed with respect to the number of data item .\n\nNotation of time complexity\n=========================\n\n1. Omega ( Ω )\n\n2. Theata ( θ )\n\n3. Big O ( O )",
      "autoResize": false,
      "lineHeight": 1.25
    },
