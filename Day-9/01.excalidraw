    {
      "id": "i-pDM55HgkeE3XwT9WXsB",
      "type": "text",
      "x": 240,
      "y": 221,
      "width": 682.9837956228421,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
