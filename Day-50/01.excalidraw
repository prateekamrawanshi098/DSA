    {
      "id": "Z-m82bs2SdAWbCS5unboY",
      "type": "text",
      "x": 792.9385963909697,
      "y": 636.7848087687443,
      "width": 545,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1c",
      "roundness": null,
      "seed": 1652668643,
      "version": 316,
      "versionNonce": 1570927309,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792747703758,
      "link": null,
      "locked": false,
      "text": "Benefits \n-----------\n\n-> Easy to implementation .\n\n-> Direct access of element using formula .\n\n-> Less memory reaquired .\n\nDrawbacks \n-------------\n\n-> Tree is not growable .\n\n-> Even if element is not there we need to take empty \nspace for validity of farmula .",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Benefits \n-----------\n\n-> Easy to implementation .\n\n-> Direct access of element using formula .\n\n-> Less memory reaquired .\n\nDrawbacks \n-------------\n\n-> Tree is not growable .\n\n-> Even if element is not there we need to take empty \nspace for validity of farmula .",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "23jtf7zSydghYnGRUblJZ",
      "type": "text",
      "x": -43.83095554912927,
      "y": 1956.6378133752914,
      "width": 515,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1d",
      "roundness": null,
      "seed": 1627769219,
      "version": 265,
      "versionNonce": 1962370861,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792747950748,
      "link": null,
      "locked": false,
      "text": "benefits \n------------\n\n1. growable \n\n2. Direct access left/right child .\n\n3. No wastage .\n\nDrawbacks\n-------------\n\n1. Difficult to implement compared to array .\n\n2. More Momory required .\n\n3. Not possible to access parent directly from child .",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "benefits \n------------\n\n1. growable \n\n2. Direct access left/right child .\n\n3. No wastage .\n\nDrawbacks\n-------------\n\n1. Difficult to implement compared to array .\n\n2. More Momory required .\n\n3. Not possible to access parent directly from child .",
      "autoResize": true,
      "lineHeight": 1.25
    }
