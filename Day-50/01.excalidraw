    {
      "id": "KEnp-8pvdopAGTc2k59SL",
      "type": "text",
      "x": 369,
      "y": 907,
      "width": 411,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 1875128643,
      "version": 209,
      "versionNonce": 1995030435,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792746550224,
      "link": null,
      "locked": false,
      "text": "If we consider i to be index of node then\n\nleft child -> i*2\nright child -> i*2+1\nparent -> i/2",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If we consider i to be index of node then\n\nleft child -> i*2\nright child -> i*2+1\nparent -> i/2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UyCfVPxZrxJBF5dpdlhqA",
      "type": "text",
      "x": 157,
      "y": 1066,
      "width": 511,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
