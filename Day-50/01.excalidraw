      "index": "aw",
      "roundness": null,
      "seed": 1055460557,
      "version": 176,
      "versionNonce": 1885482467,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792746560928,
      "link": null,
      "locked": false,
      "text": "But we should use Array representation when the\ntree is atleast Complete Binary Tree .\n\nex - HEAP .",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But we should use Array representation when the tree is atleast Complete Binary Tree .\n\nex - HEAP .",
      "autoResize": false,
      "lineHeight": 1.25
    },
