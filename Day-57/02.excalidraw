    {
      "id": "b0XQceNZxi2md2FhtVUg4",
      "type": "text",
      "x": 230,
      "y": 127,
      "width": 389,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
