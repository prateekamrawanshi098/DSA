    {
      "id": "TDmdaDCLpq49O6rSR4gaq",
      "type": "text",
      "x": 196,
      "y": 1704,
      "width": 650,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1558091463,
      "version": 156,
      "versionNonce": 412042953,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783575535701,
      "link": null,
      "locked": false,
      "text": "Custom ArrayList is an ArrayList in which we can store objects of\nprogrammer defined classes.\n\nex :\n====\n\nList <Emp> emp=new ArrayList<>();\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Custom ArrayList is an ArrayList in which we can store objects of\nprogrammer defined classes.\n\nex :\n====\n\nList <Emp> emp=new ArrayList<>();\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QOYFJ6gk1YeeiqJDs8gIq",
      "type": "text",
      "x": 193,
      "y": 1915,
      "width": 927,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 157712519,
      "version": 723,
      "versionNonce": 1540741209,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783660027579,
      "link": null,
      "locked": false,
      "text": "Special point\n============\n\n1. We must properly override toString() method in class whose objects we are storing\nin custom ArrayList. so that when we pass object referecnce to println() \nit can print the actual object rather than hashcode.\n\n2. Whenever we are planning to call remove() , contains(), indexOf in our custom ArrayList\nwe should properly override equals() method , coz when we call this methods they internally call\nequals() method for comaparison and the Object class equals is called if we do not have\nequlas in our custom ArrayList hence addresses are compared and it will always return \nfalse. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Special point\n============\n\n1. We must properly override toString() method in class whose objects we are storing\nin custom ArrayList. so that when we pass object referecnce to println() \nit can print the actual object rather than hashcode.\n\n2. Whenever we are planning to call remove() , contains(), indexOf in our custom ArrayList\nwe should properly override equals() method , coz when we call this methods they internally call\nequals() method for comaparison and the Object class equals is called if we do not have\nequlas in our custom ArrayList hence addresses are compared and it will always return \nfalse. ",
      "autoResize": true,
      "lineHeight": 1.25
    }
