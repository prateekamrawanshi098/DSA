      "updated": 1783572085721,
      "link": null,
      "locked": false,
      "text": "1. boolean remove(Object) :\n==========================\n Comes from Collection interface , seacrhes the element and delete it , \nif successful return true else returns false.\n\n2. Object remove(index) :\n===================\n\nComes from List interface , delete the element present at the index passed and return that element\nif index is wrong throws exception IndexOutOfBoundsException.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. boolean remove(Object) :\n==========================\n Comes from Collection interface , seacrhes the element and delete it , \nif successful return true else returns false.\n\n2. Object remove(index) :\n===================\n\nComes from List interface , delete the element present at the index passed and return that element\nif index is wrong throws exception IndexOutOfBoundsException.",
      "autoResize": true,
      "lineHeight": 1.25
    },
