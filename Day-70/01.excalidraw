      "link": null,
      "locked": false,
      "text": "public class LinearSearch {\n    public static int linearSearch(int [] arr, int x){\n        for (int i = 0; i <arr.length ; i++) {\n            if (arr[i]==x){\n                return i;\n            }\n        }\n        return -1;\n    }\n\n    public static void main(String[] args) {\n        int [] arr= {10, 23,12,6, 3, 18, 19, 42 ,12,45, 13};\n        System.out.println(linearSearch(arr,18));\n        System.out.println(linearSearch(arr,100));\n    }\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class LinearSearch {\n    public static int linearSearch(int [] arr, int x){\n        for (int i = 0; i <arr.length ; i++) {\n            if (arr[i]==x){\n                return i;\n            }\n        }\n        return -1;\n    }\n\n    public static void main(String[] args) {\n        int [] arr= {10, 23,12,6, 3, 18, 19, 42 ,12,45, 13};\n        System.out.println(linearSearch(arr,18));\n        System.out.println(linearSearch(arr,100));\n    }\n}\n",
      "autoResize": true,
