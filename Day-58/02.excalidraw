      "isDeleted": false,
      "boundElements": null,
      "updated": 1793263356198,
      "link": null,
      "locked": false,
      "text": "Types of TBT's based on INORDER traversal \n----------------------------------------------------------\n\n1. One way INORDER TBT\n\n2. Two way INORDER TBT\n\n3. TWO way INORDER TBT with header node",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Types of TBT's based on INORDER traversal \n----------------------------------------------------------\n\n1. One way INORDER TBT\n\n2. Two way INORDER TBT\n\n3. TWO way INORDER TBT with header node",
      "autoResize": true,
      "lineHeight": 1.25
    },
