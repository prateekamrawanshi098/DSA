    {
      "id": "Yjg3bHwd4nNBMcLO56ODR",
      "type": "text",
      "x": 196,
      "y": 854.5,
      "width": 611,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1020208184,
      "version": 225,
      "versionNonce": 1060178504,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791956251585,
      "link": null,
      "locked": false,
      "text": "1. public String() : non parametrized constructor .\n\n--> create an empty string object .\n\n\n2. public String (String s) : Parameterized constructor\n\n-->Creates a new String object containing the same sequence\nof characters as the given string.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. public String() : non parametrized constructor .\n\n--> create an empty string object .\n\n\n2. public String (String s) : Parameterized constructor\n\n-->Creates a new String object containing the same sequence of characters as the given string.\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
