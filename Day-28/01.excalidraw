    {
      "id": "zhV4cxaVmG7Chymgwga4y",
      "type": "text",
      "x": 291,
      "y": 203,
      "width": 575.1882198435544,
      "height": 1000,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1473998765,
      "version": 1180,
      "versionNonce": 1905564461,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792045977726,
      "link": null,
      "locked": false,
      "text": "It is an retricted from of array .\n\nJust like an array\n\n1. It is also an LDS .\n\n2. Stack element are homogenous .\n\n3. It is also indexed .\n\nbut unlike array \n\n1. It is open from one end only .\n\n2. It doesn't allow random access . Only allow sequencial\naccess .\n\nThus we say stack follow LIFO , Last In First Out .\n\n\nImportant terminology of stack \n---------------------------------------\n\n1. push () : method used to add element in stack . Add\nelement at the top of stack .\n\n2. pop() : method to remove element from stack, removes\nthe element at top .\n\n3. peek() : method to access the top element .\n\n4. TOS : It is called the TOP OF STACK which is an\ninteger that holds the index of current element .\n\n5. stack overflow : It is an error message when we try\nadd data in stack when it is already full .\n\n6. stack underflow : It is an error message when\nproggrammer try to access or delete element from empty\nstack .",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is an retricted from of array .\n\nJust like an array\n\n1. It is also an LDS .\n\n2. Stack element are homogenous .\n\n3. It is also indexed .\n\nbut unlike array \n\n1. It is open from one end only .\n\n2. It doesn't allow random access . Only allow sequencial access .\n\nThus we say stack follow LIFO , Last In First Out .\n\n\nImportant terminology of stack \n---------------------------------------\n\n1. push () : method used to add element in stack . Add element at the top of stack .\n\n2. pop() : method to remove element from stack, removes the element at top .\n\n3. peek() : method to access the top element .\n\n4. TOS : It is called the TOP OF STACK which is an integer that holds the index of current element .\n\n5. stack overflow : It is an error message when we try add data in stack when it is already full .\n\n6. stack underflow : It is an error message when proggrammer try to access or delete element from empty stack .",
      "autoResize": false,
      "lineHeight": 1.25
    },
